# ─────────────────────────────────────────────────────────────
# ARAS — environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────
# Required. Local Docker example:
#   postgresql://user:password@localhost:5432/aras?schema=public
# Managed example (Neon, Supabase, Railway, AWS RDS...):
#   postgresql://user:password@host:5432/aras?sslmode=require
DATABASE_URL=""

# ── Application ──────────────────────────────────────────────
# Public URL of the deployed site (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Authentication (better-auth) ─────────────────────────────
# Generate with: openssl rand -base64 32   (or node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
# MUST be at least 32 characters in production.
BETTER_AUTH_SECRET=""
# Server-facing auth URL (defaults to NEXT_PUBLIC_APP_URL).
BETTER_AUTH_URL=""

# ── Email ────────────────────────────────────────────────────
# "console" = logs e-mails to the server console (development).
# "resend"  = sends via https://resend.com (requires RESEND_API_KEY).
EMAIL_PROVIDER="console"
EMAIL_FROM="ARAS <no-reply@aras.ma>"
RESEND_API_KEY=""

# ── Image storage ────────────────────────────────────────────
# "local"     = files written to .data/uploads and served by /api/files (development / self-hosting).
# "cloudinary = uploads to Cloudinary (requires the 3 values below).
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Card payments ────────────────────────────────────────────
# ARAS never touches raw card data. The card flow redirects to a
# hosted checkout page provided by your payment gateway.
# Fill these in once you have an account with your gateway
# (e.g. CMI, PayZone, Alma, Wafacash PayZone...).
PAYMENT_PROVIDER="hosted-checkout"
PAYMENT_PROVIDER_URL=""
PAYMENT_PROVIDER_ID=""
PAYMENT_WEBHOOK_SECRET=""

# ── Tests ────────────────────────────────────────────────────
# Separate database used by the integration test suite.
TEST_DATABASE_URL=""
